#!/usr/bin/env bash
# Bloqueia push direto para a main: use pull request.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ -z "${ALLOW_MAIN:-}" ]; then
    echo "Push direto para a main bloqueado. Abra um pull request." >&2
    exit 1
  fi
done
